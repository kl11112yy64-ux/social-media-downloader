# yt-dlp 二进制下载地址（可选）
# 默认使用官方 Linux 单文件二进制（适用于 Vercel）：
# https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux
# 本地 macOS 开发可换成 yt-dlp_macos；Windows 请直接用 YTDLP_BINARY_PATH 指向 yt-dlp.exe
# YTDLP_BINARY_URL=https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_macos

# 本地开发：直接指定本机已有的 yt-dlp 可执行文件路径（优先级高于 URL 下载）
# Windows 示例：YTDLP_BINARY_PATH=C:\\tools\\yt-dlp.exe
# macOS 示例：  YTDLP_BINARY_PATH=/usr/local/bin/yt-dlp
# YTDLP_BINARY_PATH=

# 单条视频时长上限（秒），默认 3600
# MAX_DURATION_SECONDS=3600
